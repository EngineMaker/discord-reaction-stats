{
  "compilerOptions": {
    // Cloudflare Pages Functions は Workers ランタイム。Node ではなく Workers の型を使う。
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  // functions と、そこから import する src/build-report.ts を対象にする
  "include": ["**/*.ts", "../src/build-report.ts", "../src/db.ts"]
}
